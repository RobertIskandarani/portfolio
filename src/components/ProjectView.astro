---
import LinkButton from "./LinkButton.astro";
import GithubIcon from "./icons/GithubIcon.astro";
import WebIcon from "./icons/WebIcon.astro";
import L from "./L.astro";

const { web, git } = Astro.props;
---

<div
  id="container"
  class="w-full aspect-[9/12] gap-4 sm:gap-0 sm:aspect-[15/9] bg-[url('/background/Card.svg')] bg-cover bg-no-repeat group rounded-xl my-4 overflow-hidden flex flex-col justify-center items-center relative z-[3]"
>
  <slot name="img" />
  <div
    id="buttons"
    class="w-full group flex flex-col justify-center items-center gap-4 sm:gap-8"
  >
    <LinkButton href={web}>
      <WebIcon slot="icon" />
      <L es="Ir al sitio web" en="Visit website" />
    </LinkButton>
    {
      git && (
        <LinkButton href={git}>
          <GithubIcon slot='icon' color='white' />
          <L es="Ver código fuente" en="View source code" />
        </LinkButton>
      )
    }
  </div>
</div>
