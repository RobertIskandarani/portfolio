---
import Chip from './Chip.astro';
import ProjectItem from './ProjectItem.astro';
import ProjectView from './ProjectView.astro';
import AstroColorIcon from './icons/AstroColorIcon.astro';
import ExternalLinkIcon from './icons/ExternalLinkIcon.astro';
import GoogleAnalyticsIcon from './icons/GoogleAnalyticsIcon.astro';
import ReactIcon from './icons/ReactIcon.astro';
import ThirdwebIcon from './icons/ThirdwebIcon.astro';
import TypescriptIcon from './icons/TypescriptIcon.astro';
---

<div class='flex flex-col'>
  <ProjectItem>
    <a
      target='_blank'
      rel='noopener noreferrer'
      href='https://nu-world.vercel.app/'
      class='flex w-fit justify-start items-center gap-2 text-sky-400 text-lg sm:text-2xl font-bold cursor-pointer'
    >
      NU World <ExternalLinkIcon color='rgb(56 189 248)' />
    </a>
    <p class='text-balance text-[#d9d9d9] my-2'>
      Web sencilla y directa para explorar y adquirir NFTs exclusivos. Presenta
      las obras de arte digital de manera clara y permite compras directas en la
      página.
    </p>
    <div class='flex justify-start items-center gap-2 flex-wrap'>
      <Chip title='React' class='bg-[#1E5265] text-[#78D3FA]'>
        <ReactIcon slot='icon' color='#78D3FA' />
      </Chip>
      <Chip title='Google Analytics' class='bg-[#531300] text-[#EEAE3C]'>
        <GoogleAnalyticsIcon slot='icon' />
      </Chip>
      <Chip title='Thirdweb' class='bg-[#220833] text-[#B32AA7]'>
        <ThirdwebIcon slot='icon' color='#78D3FA' />
      </Chip>
    </div>
    <ProjectView
      web='https://nu-world.vercel.app/'
      git='https://github.com/RobertIskandarani/NUWorld'
    >
      <img
        src='/projects/NUWD.svg'
        alt='NUWD'
        slot='img'
        class='hidden sm:flex sm:absolute sm:-bottom-16 transition-transform duration-1000 z-[2] group-hover:translate-y-full'
      />
      <img
        src='/projects/NUWD.svg'
        alt='NUWD'
        slot='img'
        class='flex sm:hidden'
      />
    </ProjectView>
  </ProjectItem>
  <ProjectItem>
    <a
      target='_blank'
      rel='noopener noreferrer'
      href='https://iomha.vercel.app/'
      class='flex w-fit justify-start items-center gap-2 text-sky-400 text-lg sm:text-2xl font-bold cursor-pointer'
    >
      Iom ha Madrij/a <ExternalLinkIcon color='rgb(56 189 248)' />
    </a>
    <p class='text-balance text-[#d9d9d9] my-2'>
      Web de registro para un evento. Esta plataforma permite a los usuarios
      completar fácilmente sus datos para asistir al evento, y al finalizar,
      genera automáticamente un PDF personalizado con la información
      proporcionada.
    </p>
    <div class='flex justify-start items-center gap-2 flex-wrap'>
      <Chip title='React' class='bg-[#1E5265] text-[#78D3FA]'>
        <ReactIcon slot='icon' color='#78D3FA' />
      </Chip>
      <Chip title='Typescript' class='bg-[#021531] text-[#4182D8]'>
        <TypescriptIcon slot='icon' color='#4182D8' />
      </Chip>
    </div>
    <ProjectView
      web='https://iomha.vercel.app/'
      git='https://github.com/RobertIskandarani/Iomha'
    >
      <img
        src='/projects/Iomha.svg'
        alt='Iom ha madrij/a'
        slot='img'
        class='hidden sm:flex sm:absolute sm:-bottom-16 transition-transform duration-1000 z-[2] group-hover:translate-y-full'
      />
      <img
        src='/projects/Iomha.svg'
        alt='Iom ha madrij/a'
        slot='img'
        class='flex sm:hidden'
      />
    </ProjectView>
  </ProjectItem>
  <ProjectItem>
    <a
      target='_blank'
      rel='noopener noreferrer'
      href='https://sordoperonomudo.com/'
      class='flex w-fit justify-start items-center gap-2 text-sky-400 text-lg sm:text-2xl font-bold cursor-pointer'
    >
      Sordo Pero No Mudo <ExternalLinkIcon color='rgb(56 189 248)' />
    </a>
    <p class='text-balance text-[#d9d9d9] my-2'>
      Sitio web oficial del podcast “Sordo pero no mudo”. Diseñado para
      visibilizar la hipoacusia a través de episodios, testimonios e información
      accesible. Incluye integración con plataformas externas como Spotify y
      YouTube, y fomenta la participación de la comunidad.
    </p>
    <div class='flex justify-start items-center gap-2 flex-wrap'>
      <Chip title='Astro' class='bg-[#5e2a0d] text-[#FF5D01]'>
        <AstroColorIcon slot='icon' color='#78D3FA' />
      </Chip>
      <Chip title='Typescript' class='bg-[#021531] text-[#4182D8]'>
        <TypescriptIcon slot='icon' color='#4182D8' />
      </Chip>
    </div>
    <ProjectView
      web='https://sordoperonomudo.com/'
      git='https://github.com/RobertIskandarani/sordoperonomudo/tree/main'
    >
      <img
        src='/projects/sordo-pero-no-mudo.png'
        alt='Sordo Pero No Mudo'
        slot='img'
        class='hidden sm:flex sm:absolute sm:-bottom-16 transition-transform duration-1000 z-[2] group-hover:translate-y-full'
      />
      <img
        src='/projects/sordo-pero-no-mudo.png'
        alt='Sordo Pero No Mudo'
        slot='img'
        class='flex sm:hidden'
      />
    </ProjectView>
  </ProjectItem>
  <ProjectItem>
    <a
      target='_blank'
      rel='noopener noreferrer'
      href='https://100-macabeos-dicen.vercel.app/'
      class='flex w-fit justify-start items-center gap-2 text-sky-400 text-lg sm:text-2xl font-bold cursor-pointer'
    >
      100 Macabeos dicen <ExternalLinkIcon color='rgb(56 189 248)' />
    </a>
    <p class='text-balance text-[#d9d9d9] my-2'>
      Web para jugar al juego de 100 argentinos dicen personalizado
      especialmente para un evento del club Macabi.
    </p>
    <div class='flex justify-start items-center gap-2 flex-wrap'>
      <Chip title='React' class='bg-[#1E5265] text-[#78D3FA]'>
        <ReactIcon slot='icon' color='#78D3FA' />
      </Chip>
    </div>
    <ProjectView
      web='https://100-macabeos-dicen.vercel.app/'
      git='https://github.com/RobertIskandarani/100-macabeos-dicen'
    >
      <img
        src='/projects/100-macabeos-dicen.svg'
        alt='100 Macabeos dicen'
        slot='img'
        class='hidden sm:flex sm:absolute sm:-bottom-16 transition-transform duration-1000 z-[2] group-hover:translate-y-full'
      />
      <img
        src='/projects/100-macabeos-dicen.svg'
        alt='100 Macabeos dicen'
        slot='img'
        class='flex sm:hidden'
      />
    </ProjectView>
  </ProjectItem>
</div>
