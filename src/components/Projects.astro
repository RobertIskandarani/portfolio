---
import { projects } from "@/data/profile";
import Chip from "./Chip.astro";
import ProjectItem from "./ProjectItem.astro";
import ProjectView from "./ProjectView.astro";
import AstroColorIcon from "./icons/AstroColorIcon.astro";
import ExternalLinkIcon from "./icons/ExternalLinkIcon.astro";
import GoogleAnalyticsIcon from "./icons/GoogleAnalyticsIcon.astro";
import ReactIcon from "./icons/ReactIcon.astro";
import TailwindIcon from "./icons/TailwindIcon.astro";
import ThirdwebIcon from "./icons/ThirdwebIcon.astro";
import TypescriptIcon from "./icons/TypescriptIcon.astro";
import L from "./L.astro";

const iconColorMap: Record<string, string> = {
  react: "#78D3FA",
  typescript: "#4182D8",
  astro: "#FF5D01",
  thirdweb: "#78D3FA",
  tailwind: "#38BDF8",
};
---

<div class='flex flex-col'>
  {
    projects.map((project, index) => (
      <ProjectItem class='' data-reveal data-reveal-delay={index * 100}>
        <a
          target='_blank'
          rel='noopener noreferrer'
          href={project.url}
          class='flex w-fit justify-start items-center gap-2 text-sky-400 text-lg sm:text-2xl font-bold cursor-pointer'
          aria-label={`Abrir ${project.name} en una nueva pestaña`}
        >
          {project.name} <ExternalLinkIcon color='rgb(56 189 248)' />
        </a>
        <p class='text-balance text-[#d9d9d9] my-2'>
          <L es={project.description} en={project.descriptionEn} />
        </p>
        <div class='flex justify-start items-center gap-2 flex-wrap'>
          {project.tech.map((t) => (
            <Chip title={t.name} class={`${t.bg} ${t.text}`}>
              {t.icon === "react" && <ReactIcon slot='icon' color={iconColorMap.react} />}
              {t.icon === "typescript" && (
                <TypescriptIcon slot='icon' color={iconColorMap.typescript} />
              )}
              {t.icon === "astro" && <AstroColorIcon slot='icon' />}
              {t.icon === "google-analytics" && <GoogleAnalyticsIcon slot='icon' />}
              {t.icon === "thirdweb" && (
                <ThirdwebIcon slot='icon' color={iconColorMap.thirdweb} />
              )}
              {t.icon === "tailwind" && <TailwindIcon slot='icon' />}
            </Chip>
          ))}
        </div>
        <ProjectView web={project.url} git={project.repo}>
          <img
            src={project.image}
            alt={project.imageAlt}
            slot='img'
            loading='lazy'
            decoding='async'
            class='hidden sm:flex sm:absolute sm:-bottom-16 transition-transform duration-1000 z-[2] group-hover:translate-y-full'
          />
          <img
            src={project.image}
            alt={project.imageAlt}
            slot='img'
            loading='lazy'
            decoding='async'
            class='flex sm:hidden'
          />
        </ProjectView>
      </ProjectItem>
    ))
  }
</div>
