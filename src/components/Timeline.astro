---
import { experiences } from "@/data/profile";
import L from "./L.astro";
---

<ol
  class='relative border-s-0 sm:border-s sm:ps-10 border-white/25'
>
  {
    experiences.map((exp, index) => {
      const isCurrent = exp.end === "Actualidad";
      const datetimeISO = isCurrent
        ? exp.startISO
        : `${exp.startISO}/${exp.endISO ?? ""}`;

      return (
        <li
          class='timeline-item group mb-6 sm:mb-8 p-4 sm:p-5 bg-[#181820] border border-white/10 sm:border-white/15 rounded-2xl relative shadow-[0_8px_30px_rgba(0,0,0,0.3)] transition-all duration-300 hover:-translate-y-0.5 hover:border-sky-400/40 hover:shadow-[0_10px_40px_rgba(56,189,248,0.12)]'
          data-reveal
          data-reveal-delay={index * 120}
        >
          <div
            class:list={[
              "timeline-dot hidden sm:block absolute w-3.5 h-3.5 bg-[#181820] rounded-full -start-[47px] top-6 border-2 border-white",
              isCurrent && "timeline-dot-current",
            ]}
          />

          <div class='flex justify-between items-start gap-3 mb-3'>
            {exp.logo ? (
              <span class='inline-flex items-center justify-center bg-white rounded-lg px-2.5 py-1.5 ring-1 ring-white/15 shadow-[0_2px_10px_rgba(255,255,255,0.06)] shrink-0'>
                <img
                  src={exp.logo}
                  alt={exp.logoAlt}
                  loading='lazy'
                  decoding='async'
                  class='h-7 sm:h-8 w-auto'
                />
              </span>
            ) : (
              <span
                class='inline-flex items-center justify-center bg-white rounded-lg w-11 h-11 sm:w-[3.1rem] sm:h-[3.1rem] ring-1 ring-white/15 shadow-[0_2px_10px_rgba(255,255,255,0.06)] shrink-0'
                aria-hidden='true'
              >
                <span
                  class='text-[#181820] font-black text-xl sm:text-2xl leading-none'
                  style='font-family: ui-serif, Georgia, "Times New Roman", serif; letter-spacing: -0.02em;'
                >
                  {exp.company.slice(0, 1).toUpperCase()}
                </span>
              </span>
            )}

            <div class='flex flex-col items-end gap-1.5 shrink-0 text-right'>
              <time
                datetime={datetimeISO}
                class='text-[11px] sm:text-xs font-medium text-white/60 tracking-wide whitespace-nowrap'
              >
                <L
                  es={`${exp.start} — ${exp.end}`}
                  en={`${exp.startEn} — ${exp.endEn}`}
                />
              </time>
              {isCurrent && (
                <span class='inline-flex items-center gap-1.5 text-[10px] sm:text-[11px] font-semibold uppercase tracking-wider text-sky-300 bg-sky-400/10 ring-1 ring-sky-400/30 rounded-full px-2 py-0.5'>
                  <span class='w-1.5 h-1.5 bg-sky-400 rounded-full animate-pulse' />
                  <L es='Actualidad' en='Present' />
                </span>
              )}
            </div>
          </div>

          <div class='mb-2'>
            <h3 class='text-lg sm:text-xl font-semibold text-white text-balance leading-tight'>
              <L es={exp.role} en={exp.roleEn} />
            </h3>
            <div class='flex flex-wrap items-center gap-x-2 gap-y-0.5 text-sm mt-0.5'>
              {exp.url ? (
                <a
                  href={exp.url}
                  target='_blank'
                  rel='noopener noreferrer'
                  class='text-sky-400 hover:text-sky-300 transition-colors font-medium'
                  aria-label={`Sitio web de ${exp.company}`}
                >
                  {exp.company}
                </a>
              ) : (
                <span class='text-white/85 font-medium'>{exp.company}</span>
              )}
              {exp.location && (
                <>
                  <span class='text-white/30'>·</span>
                  <span class='text-white/55'>
                    <L
                      es={exp.location}
                      en={exp.locationEn ?? exp.location}
                    />
                  </span>
                </>
              )}
            </div>
          </div>

          <p class='text-sm sm:text-[15px] text-white/70 leading-relaxed text-pretty'>
            <L es={exp.description} en={exp.descriptionEn} />
          </p>

          {exp.tags && exp.tags.length > 0 && (
            <div class='flex flex-wrap gap-1.5 mt-3'>
              {exp.tags.map((tag) => (
                <span class='text-[11px] sm:text-xs font-medium text-white/75 bg-white/5 hover:bg-white/10 ring-1 ring-white/10 rounded-md px-2 py-0.5 transition-colors'>
                  {tag}
                </span>
              ))}
            </div>
          )}
        </li>
      );
    })
  }
</ol>

<style>
  .timeline-dot-current {
    background-color: #38bdf8 !important;
    box-shadow: 0 0 0 0 rgba(56, 189, 248, 0.6);
    animation: timeline-pulse 2.2s ease-out infinite;
  }

  @keyframes timeline-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(56, 189, 248, 0.6);
    }
    70% {
      box-shadow: 0 0 0 10px rgba(56, 189, 248, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(56, 189, 248, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-dot-current {
      animation: none;
    }
    .timeline-item {
      transition: none !important;
    }
  }
</style>
