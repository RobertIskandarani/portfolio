---
const { class: className, name } = Astro.props;
---

<figure
  class={`planet ${className} w-[10%] p-1 aspect-square flex justify-center items-center bg-white rounded-full absolute`}
  data-name={name}
>
  <slot />
</figure>

<style>
  .planet {
    transition:
      filter 0.25s ease,
      box-shadow 0.3s ease,
      background 0.3s ease;
  }

  .planet :global(svg) {
    filter: grayscale(100%) contrast(1.05);
    transition: filter 0.25s ease;
  }

  .planet:hover :global(svg) {
    filter: grayscale(100%) contrast(1.05)
      drop-shadow(0 0 0.5px rgba(0, 0, 0, 0.6));
  }

  .planet:hover {
    z-index: 5;
    background: radial-gradient(
      circle at center,
      #ffffff 55%,
      rgba(56, 189, 248, 0.55) 100%
    );
    box-shadow:
      0 0 18px 4px rgba(56, 189, 248, 0.6),
      0 0 0 6px rgba(56, 189, 248, 0.35),
      0 0 0 14px rgba(56, 189, 248, 0.12),
      0 0 42px 20px rgba(129, 140, 248, 0.4) !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .planet {
      animation: none !important;
    }
  }

  @keyframes planet {
    from {
      box-shadow:
        0 0 0 0.5px rgba(255, 255, 255, 0.2),
        0 0 0 5px rgba(255, 255, 255, 0.05);
    }
    to {
      box-shadow:
        0 0 0 5px rgba(255, 255, 255, 0.2),
        0 0 0 10px rgba(255, 255, 255, 0.05);
    }
  }

  @keyframes orbit-2-1 {
    from {
      transform: rotate(0deg) translate(500%) rotate(0deg);
    }
    to {
      transform: rotate(360deg) translate(500%) rotate(-360deg);
    }
  }

  @keyframes orbit-2-2 {
    from {
      transform: rotate(180deg) translate(500%) rotate(0deg);
    }
    to {
      transform: rotate(540deg) translate(500%) rotate(-360deg);
    }
  }

  @keyframes orbit-3-1 {
    from {
      transform: rotate(0deg) translate(500%) rotate(0deg);
    }
    to {
      transform: rotate(360deg) translate(500%) rotate(-360deg);
    }
  }

  @keyframes orbit-3-2 {
    from {
      transform: rotate(120deg) translate(500%) rotate(0deg);
    }
    to {
      transform: rotate(480deg) translate(500%) rotate(-360deg);
    }
  }

  @keyframes orbit-3-3 {
    from {
      transform: rotate(240deg) translate(500%) rotate(0deg);
    }
    to {
      transform: rotate(600deg) translate(500%) rotate(-360deg);
    }
  }

  @keyframes orbit-6-1 {
    from {
      transform: rotate(0deg) translate(500%) rotate(0deg);
    }
    to {
      transform: rotate(360deg) translate(500%) rotate(-360deg);
    }
  }

  @keyframes orbit-6-2 {
    from {
      transform: rotate(60deg) translate(500%) rotate(0deg);
    }
    to {
      transform: rotate(420deg) translate(500%) rotate(-360deg);
    }
  }

  @keyframes orbit-6-3 {
    from {
      transform: rotate(120deg) translate(500%) rotate(0deg);
    }
    to {
      transform: rotate(480deg) translate(500%) rotate(-360deg);
    }
  }

  @keyframes orbit-6-4 {
    from {
      transform: rotate(180deg) translate(500%) rotate(0deg);
    }
    to {
      transform: rotate(540deg) translate(500%) rotate(-360deg);
    }
  }

  @keyframes orbit-6-5 {
    from {
      transform: rotate(240deg) translate(500%) rotate(0deg);
    }
    to {
      transform: rotate(600deg) translate(500%) rotate(-360deg);
    }
  }

  @keyframes orbit-6-6 {
    from {
      transform: rotate(300deg) translate(500%) rotate(0deg);
    }
    to {
      transform: rotate(660deg) translate(500%) rotate(-360deg);
    }
  }

  @keyframes orbit-4-1 {
    from {
      transform: rotate(0deg) translate(500%) rotate(0deg);
    }
    to {
      transform: rotate(360deg) translate(500%) rotate(-360deg);
    }
  }

  @keyframes orbit-4-2 {
    from {
      transform: rotate(90deg) translate(500%) rotate(0deg);
    }
    to {
      transform: rotate(450deg) translate(500%) rotate(-360deg);
    }
  }

  @keyframes orbit-4-3 {
    from {
      transform: rotate(180deg) translate(500%) rotate(0deg);
    }
    to {
      transform: rotate(540deg) translate(500%) rotate(-360deg);
    }
  }

  @keyframes orbit-4-4 {
    from {
      transform: rotate(270deg) translate(500%) rotate(0deg);
    }
    to {
      transform: rotate(630deg) translate(500%) rotate(-360deg);
    }
  }
</style>
