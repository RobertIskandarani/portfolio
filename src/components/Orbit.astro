---
import ReactIcon from "@/components/icons/ReactIcon.astro";
import Planet from "@/components/Planet.astro";
import PythonIcon from "@/components/icons/PythonIcon.astro";
import HTML5Icon from "@/components/icons/HTML5Icon.astro";
import CSSIcon from "@/components/icons/CSSIcon.astro";
import MongoDBIcon from "@/components/icons/MongoDBIcon.astro";
import FigmaIcon from "@/components/icons/FigmaIcon.astro";
import PhotoshopIcon from "@/components/icons/PhotoshopIcon.astro";
import PostmanIcon from "@/components/icons/PostmanIcon.astro";
import GitIcon from "@/components/icons/GitIcon.astro";
import GithubIcon from "@/components/icons/GithubIcon.astro";
import GitlabIcon from "@/components/icons/GitlabIcon.astro";
import NodeJSIcon from "@/components/icons/NodeJSIcon.astro";
import JavascriptIcon from "@/components/icons/JavascriptIcon.astro";
import TypescriptIcon from "@/components/icons/TypescriptIcon.astro";
import TailwindIcon from "@/components/icons/TailwindIcon.astro";
import AstroIcon from "@/components/icons/AstroIcon.astro";
import OpenAIIcon from "@/components/icons/OpenAIIcon.astro";
import ClaudeIcon from "@/components/icons/ClaudeIcon.astro";
---

<div class='flex flex-col items-center w-full'>
  <article
    id='orbit-root'
    class='orbit rounded-full border border-transparent flex justify-center items-center w-[92vw] sm:w-2/3 max-w-[720px] aspect-square relative mx-auto'
  >
  <Planet
    name='React'
    class='animate-[planet_3s_ease-in-out_infinite_alternate,orbit-2-2_15s_linear_infinite_reverse]'
  >
    <ReactIcon />
  </Planet>
  <Planet
    name='Astro'
    class='animate-[planet_3s_ease-in-out_infinite_alternate,orbit-2-1_15s_linear_infinite_reverse]'
  >
    <AstroIcon />
  </Planet>
  <div
    class='orbit rounded-full border border-transparent flex justify-center items-center w-4/5 aspect-square relative'
  >
    <Planet
      name='HTML5'
      class='animate-[planet_3s_ease-in-out_infinite_alternate,orbit-3-3_25s_linear_infinite]'
    >
      <HTML5Icon />
    </Planet>
    <Planet
      name='CSS'
      class='animate-[planet_3s_ease-in-out_infinite_alternate,orbit-3-2_25s_linear_infinite]'
    >
      <CSSIcon />
    </Planet>
    <Planet
      name='Tailwind'
      class='animate-[planet_3s_ease-in-out_infinite_alternate,orbit-3-1_25s_linear_infinite]'
    >
      <TailwindIcon />
    </Planet>
    <div
      class='orbit rounded-full border border-transparent flex justify-center items-center w-4/5 aspect-square relative'
    >
      <Planet
        name='Node.js'
        class='animate-[planet_3s_ease-in-out_infinite_alternate,orbit-3-3_20s_linear_infinite_reverse]'
      >
        <NodeJSIcon />
      </Planet>
      <Planet
        name='JavaScript'
        class='animate-[planet_3s_ease-in-out_infinite_alternate,orbit-3-2_20s_linear_infinite_reverse]'
      >
        <JavascriptIcon />
      </Planet>
      <Planet
        name='TypeScript'
        class='animate-[planet_3s_ease-in-out_infinite_alternate,orbit-3-1_20s_linear_infinite_reverse]'
      >
        <TypescriptIcon />
      </Planet>
      <div
        class='orbit rounded-full border border-transparent flex justify-center items-center w-4/5 aspect-square relative'
      >
        <Planet
          name='Git'
          class='animate-[planet_3s_ease-in-out_infinite_alternate,orbit-3-3_30s_linear_infinite]'
        >
          <GitIcon />
        </Planet>
        <Planet
          name='GitHub'
          class='animate-[planet_3s_ease-in-out_infinite_alternate,orbit-3-2_30s_linear_infinite]'
        >
          <GithubIcon color='black' />
        </Planet>
        <Planet
          name='GitLab'
          class='animate-[planet_3s_ease-in-out_infinite_alternate,orbit-3-1_30s_linear_infinite]'
        >
          <GitlabIcon />
        </Planet>
        <div
          class='orbit rounded-full border border-transparent flex justify-center items-center w-4/5 aspect-square relative'
        >
          <Planet
            name='Figma'
            class='animate-[planet_3s_ease-in-out_infinite_alternate,orbit-3-3_30s_linear_infinite_reverse]'
          >
            <FigmaIcon />
          </Planet>
          <Planet
            name='Photoshop'
            class='animate-[planet_3s_ease-in-out_infinite_alternate,orbit-3-2_30s_linear_infinite_reverse]'
          >
            <PhotoshopIcon />
          </Planet>
          <Planet
            name='Postman'
            class='animate-[planet_3s_ease-in-out_infinite_alternate,orbit-3-1_30s_linear_infinite_reverse]'
          >
            <PostmanIcon />
          </Planet>
          <div
            class='orbit rounded-full border border-transparent flex justify-center items-center w-4/5 aspect-square relative'
          >
            <Planet
              name='Python'
              class='animate-[planet_3s_ease-in-out_infinite_alternate,orbit-4-1_22s_linear_infinite_reverse]'
            >
              <PythonIcon />
            </Planet>
            <Planet
              name='OpenAI'
              class='animate-[planet_3s_ease-in-out_infinite_alternate,orbit-4-2_22s_linear_infinite_reverse]'
            >
              <OpenAIIcon />
            </Planet>
            <Planet
              name='Claude'
              class='animate-[planet_3s_ease-in-out_infinite_alternate,orbit-4-3_22s_linear_infinite_reverse]'
            >
              <ClaudeIcon />
            </Planet>
            <Planet
              name='MongoDB'
              class='animate-[planet_3s_ease-in-out_infinite_alternate,orbit-4-4_22s_linear_infinite_reverse]'
            >
              <MongoDBIcon />
            </Planet>
            <span
              id='profile2'
              data-cursor='image'
              class="w-3/4 h-4/5 bg-[url('/profile/profile2.webp')] flex justify-center items-end rounded-b-full bg-no-repeat bg-center bg-[length:auto_135%] relative"
            ></span>
          </div>
        </div>
      </div>
    </div>
  </div>
  </article>
  <p
    id='orbit-label'
    aria-live='polite'
    class='mt-8 sm:mt-10 px-5 py-2 rounded-full bg-white/5 border border-white/15 text-white text-sm sm:text-base font-semibold tracking-wide text-center min-w-[140px] sm:min-w-[180px] opacity-0 transition-opacity duration-200 backdrop-blur-sm'
  >
    &nbsp;
  </p>
</div>

<script>
  const root = document.getElementById("orbit-root");
  const label = document.getElementById("orbit-label");
  if (root && label) {
    root.addEventListener(
      "mouseover",
      (event) => {
        const target = event.target as Element | null;
        const planet = target?.closest?.(".planet");
        if (planet) {
          const name = planet.getAttribute("data-name") ?? "";
          if (name) {
            label.textContent = name;
            label.style.opacity = "1";
          }
        }
      },
      { passive: true }
    );
    root.addEventListener("mouseleave", () => {
      label.style.opacity = "0";
    });
  }
</script>

<style>
  #profile2::before {
    content: "";
    width: 100%;
    height: 93.75%;
    border-radius: 50%;
    background-color: #070707;
    z-index: -1;
  }

  .orbit::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      45deg,
      rgba(255, 255, 255, 0.6),
      rgba(255, 255, 255, 0.4),
      rgba(255, 255, 255, 0.3),
      rgba(255, 255, 255, 0.2),
      rgba(255, 255, 255, 0.05),
      rgba(255, 255, 255, 0.1),
      rgba(255, 255, 255, 0.3),
      rgba(255, 255, 255, 0.4),
      rgba(255, 255, 255, 0.6)
    );
    border: inherit;
    border-radius: inherit;
    mask:
      linear-gradient(white, white) padding-box,
      linear-gradient(white, white);
    mask-composite: exclude;
  }

  #orbit-root:hover :global(.planet) {
    animation-play-state: paused;
  }
</style>
