---
import ArrowUpIcon from "./icons/ArrowUpIcon.astro";
---

<a
  href='#'
  id='top-button'
  aria-label='Volver arriba'
  data-magnetic
  class='top-button group fixed right-4 sm:right-6 bottom-6 sm:bottom-10 z-20'
>
  <span class='top-button-ring' aria-hidden='true'></span>
  <span class='top-button-inner'>
    <ArrowUpIcon />
  </span>
</a>

<script>
  const btn = document.getElementById("top-button");
  const footer = document.getElementById("site-footer");
  if (btn && footer && "IntersectionObserver" in window) {
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          btn.classList.toggle("near-footer", entry.isIntersecting);
        });
      },
      { threshold: 0.01 }
    );
    obs.observe(footer);
  }
</script>

<style>
  .top-button {
    --size: 3.25rem;
    display: inline-flex;
    width: var(--size);
    height: var(--size);
    border-radius: 9999px;
    isolation: isolate;
  }

  @media (min-width: 640px) {
    .top-button {
      --size: 3.75rem;
    }
  }

  .top-button-ring {
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    background: conic-gradient(
      from 45deg,
      rgba(56, 189, 248, 0.9),
      rgba(129, 140, 248, 0.4),
      rgba(244, 114, 182, 0.9),
      rgba(56, 189, 248, 0.9)
    );
    opacity: 0.85;
    animation: spin 4s linear infinite;
    z-index: 0;
  }

  .top-button-inner {
    position: relative;
    z-index: 1;
    inset: 0;
    margin: auto;
    width: calc(100% - 3px);
    height: calc(100% - 3px);
    border-radius: 9999px;
    background: #0f0f0f;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      transform 0.25s ease,
      background-color 0.25s ease;
  }

  .top-button:hover .top-button-inner {
    background: #181818;
    transform: translateY(-2px);
  }

  .top-button :global(svg) {
    width: 40%;
    height: 40%;
    transition: transform 0.3s ease;
  }

  .top-button:hover :global(svg) {
    transform: translateY(-2px);
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .top-button {
    animation: show-arrow linear both;
    animation-timeline: scroll(root);
    animation-range: 50vh 100vh;
  }

  @keyframes show-arrow {
    0% {
      opacity: 0;
      transform: translateY(10px) scale(0.9);
      pointer-events: none;
    }
    50% {
      opacity: 0;
      transform: translateY(10px) scale(0.9);
      pointer-events: none;
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
      pointer-events: auto;
    }
  }

  .top-button.near-footer {
    opacity: 0;
    pointer-events: none;
    transform: translateY(20px) scale(0.85);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .top-button {
      animation: none;
      opacity: 1;
    }
    .top-button-ring {
      animation: none;
    }
  }
</style>
