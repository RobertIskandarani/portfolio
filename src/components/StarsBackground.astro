---
const { class: className } = Astro.props;
---

<canvas
  id='stars-canvas'
  class={`${className ?? ""} fixed inset-0 w-full h-full -z-50`}
  aria-hidden='true'></canvas>

<style>
  #stars-canvas {
    pointer-events: none;
    background:
      radial-gradient(
        ellipse at 20% 10%,
        rgba(56, 189, 248, 0.08),
        transparent 55%
      ),
      radial-gradient(
        ellipse at 80% 80%,
        rgba(129, 140, 248, 0.06),
        transparent 60%
      ),
      #050507;
  }
</style>

<script>
  type Star = {
    x: number;
    y: number;
    r: number;
    base: number;
    twinkleSpeed: number;
    twinklePhase: number;
    hue: number;
  };

  type ShootingStar = {
    x: number;
    y: number;
    len: number;
    speed: number;
    angle: number;
    life: number;
    maxLife: number;
    hue: number | null;
    thickness: number;
  };

  const canvas = document.getElementById("stars-canvas") as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext("2d", { alpha: true });
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    let stars: Star[] = [];
    const shootingStars: ShootingStar[] = [];
    let width = 0;
    let height = 0;
    let dpr = 1;

    const STAR_DENSITY = 0.00042;
    const MIN_RADIUS = 0.25;
    const MAX_RADIUS = 1.9;

    const initStars = () => {
      const count = Math.min(
        Math.max(Math.floor(width * height * STAR_DENSITY), 260),
        900
      );
      stars = new Array(count).fill(0).map(() => ({
        x: Math.random() * width,
        y: Math.random() * height,
        r:
          MIN_RADIUS +
          Math.pow(Math.random(), 3.2) * (MAX_RADIUS - MIN_RADIUS),
        base: 0.3 + Math.random() * 0.6,
        twinkleSpeed: 0.0005 + Math.random() * 0.002,
        twinklePhase: Math.random() * Math.PI * 2,
        hue:
          Math.random() < 0.1
            ? 200 + Math.random() * 50
            : Math.random() < 0.06
              ? 30 + Math.random() * 25
              : Math.random() < 0.03
                ? 0 + Math.random() * 15
                : 0,
      }));
    };

    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      if (ctx) ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      initStars();
    };

    const spawnShootingStar = () => {
      const flavor = Math.random();
      // All meteors share the same diagonal direction (top-left → bottom-right)
      // with a tiny natural wobble; only the spawn position varies across the sky.
      const baseAngle = 28;
      const angleDeg = baseAngle + (Math.random() - 0.5) * 6;
      const angleRad = (Math.PI * angleDeg) / 180;
      // Pick a spawn point along the top + left edges so the trajectory crosses the viewport.
      const trailRun = 1.2 * (width + height);
      const startX = -Math.cos(angleRad) * 80 + Math.random() * width * 1.1;
      const startY = -Math.sin(angleRad) * 80 + (Math.random() * height - height * 0.15);
      // Tiny meteor 30% of the time, big 15% of the time, medium otherwise
      const sizeRoll = Math.random();
      const len =
        sizeRoll < 0.3
          ? 70 + Math.random() * 60
          : sizeRoll < 0.85
            ? 140 + Math.random() * 140
            : 280 + Math.random() * 200;
      const speed =
        sizeRoll < 0.3
          ? 9 + Math.random() * 5
          : sizeRoll < 0.85
            ? 5 + Math.random() * 4
            : 3 + Math.random() * 3;
      // 12% cyan, 8% warm, 4% pinkish, rest white
      let hue: number | null = null;
      if (flavor < 0.12) hue = 200 + Math.random() * 40;
      else if (flavor < 0.2) hue = 30 + Math.random() * 20;
      else if (flavor < 0.24) hue = 320 + Math.random() * 30;
      shootingStars.push({
        x: startX,
        y: startY,
        len,
        speed,
        angle: angleRad,
        life: 0,
        maxLife: Math.min(160, trailRun / speed),
        hue,
        thickness: 1.1 + Math.random() * 1.2,
      });
    };

    const draw = (t: number) => {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      for (const s of stars) {
        const tw =
          s.base +
          0.4 * Math.sin(t * s.twinkleSpeed + s.twinklePhase);
        const alpha = Math.max(0.05, Math.min(1, tw));
        const color =
          s.hue === 0
            ? `rgba(255, 255, 255, ${alpha})`
            : `hsla(${s.hue}, 75%, 75%, ${alpha})`;
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        ctx.fillStyle = color;
        ctx.fill();
        if (s.r > 1.1) {
          ctx.beginPath();
          ctx.arc(s.x, s.y, s.r * 2.4, 0, Math.PI * 2);
          ctx.fillStyle =
            s.hue === 0
              ? `rgba(255, 255, 255, ${alpha * 0.08})`
              : `hsla(${s.hue}, 80%, 80%, ${alpha * 0.08})`;
          ctx.fill();
        }
      }

      for (let i = shootingStars.length - 1; i >= 0; i--) {
        const sh = shootingStars[i];
        sh.life += 1;
        const dx = Math.cos(sh.angle) * sh.speed;
        const dy = Math.sin(sh.angle) * sh.speed;
        sh.x += dx;
        sh.y += dy;

        const tailX = sh.x - Math.cos(sh.angle) * sh.len;
        const tailY = sh.y - Math.sin(sh.angle) * sh.len;
        const fadeIn = Math.min(1, sh.life / 8);
        const fadeOut = Math.min(1, (sh.maxLife - sh.life) / 18);
        const alpha = Math.max(0, Math.min(1, fadeIn * fadeOut));

        const gradient = ctx.createLinearGradient(
          tailX,
          tailY,
          sh.x,
          sh.y
        );
        const head =
          sh.hue === null
            ? `rgba(255, 255, 255, ${alpha})`
            : `hsla(${sh.hue}, 90%, 78%, ${alpha})`;
        const mid =
          sh.hue === null
            ? `rgba(190, 220, 255, ${alpha * 0.45})`
            : `hsla(${sh.hue}, 85%, 70%, ${alpha * 0.45})`;
        gradient.addColorStop(0, "rgba(255, 255, 255, 0)");
        gradient.addColorStop(0.6, mid);
        gradient.addColorStop(1, head);
        ctx.strokeStyle = gradient;
        ctx.lineWidth = sh.thickness;
        ctx.beginPath();
        ctx.moveTo(tailX, tailY);
        ctx.lineTo(sh.x, sh.y);
        ctx.stroke();

        ctx.beginPath();
        ctx.arc(sh.x, sh.y, sh.thickness + 0.6, 0, Math.PI * 2);
        ctx.fillStyle = head;
        ctx.fill();

        if (
          sh.life >= sh.maxLife ||
          sh.x > width + sh.len ||
          sh.y > height + sh.len
        ) {
          shootingStars.splice(i, 1);
        }
      }

      requestAnimationFrame(draw);
    };

    resize();
    window.addEventListener("resize", resize);

    if (!prefersReducedMotion) {
      requestAnimationFrame(draw);
      const scheduleNext = () => {
        const delay = 2500 + Math.random() * 7500;
        window.setTimeout(() => {
          if (document.visibilityState === "visible") {
            spawnShootingStar();
            // Occasionally fire a quick follow-up meteor (mini-shower)
            if (Math.random() < 0.18) {
              window.setTimeout(spawnShootingStar, 250 + Math.random() * 500);
            }
          }
          scheduleNext();
        }, delay);
      };
      scheduleNext();
    } else {
      if (ctx) {
        for (const s of stars) {
          ctx.beginPath();
          ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(255, 255, 255, ${s.base})`;
          ctx.fill();
        }
      }
    }
  }
</script>
