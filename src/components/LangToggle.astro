---

<button
  id='lang-toggle'
  type='button'
  aria-label='Cambiar idioma / Switch language'
  class='lang-toggle shrink-0 relative flex items-center gap-1 text-[10px] sm:text-sm font-semibold text-white/80 rounded-full bg-[#070707] border border-white/15 px-2 sm:px-2.5 py-1 hover:bg-white/10 hover:text-white transition-colors'
>
  <span class='lang-opt' data-value='es'>ES</span>
  <span class='lang-sep text-white/30'>/</span>
  <span class='lang-opt' data-value='en'>EN</span>
</button>

<style>
  .lang-opt {
    transition: color 0.2s ease;
  }
  :global(html[lang="es"]) .lang-opt[data-value="es"],
  :global(html[lang="en"]) .lang-opt[data-value="en"] {
    color: #38bdf8;
  }
  :global(html[lang="es"]) .lang-opt[data-value="en"],
  :global(html[lang="en"]) .lang-opt[data-value="es"] {
    color: rgba(255, 255, 255, 0.45);
  }
</style>

<script is:inline>
  (() => {
    const stored = localStorage.getItem("lang");
    const initial = stored === "en" || stored === "es" ? stored : "es";
    document.documentElement.lang = initial;
  })();

  document.addEventListener("DOMContentLoaded", () => {
    const btn = document.getElementById("lang-toggle");
    if (!btn) return;
    btn.addEventListener("click", () => {
      const cur = document.documentElement.lang;
      const next = cur === "es" ? "en" : "es";
      document.documentElement.lang = next;
      localStorage.setItem("lang", next);
    });
  });
</script>
